# Copia este archivo a `.env` en la raíz del workspace y ajustá si hace falta.
# Ningún valor de este archivo es una credencial real (RNF-04): las keys
# opcionales P1 están vacías. El sistema corre en modo demo con los defaults,
# sin API keys ni red (RNF-01).

# Entorno: habilita /docs, /openapi.json y CORS de desarrollo.
APP_ENV=dev
API_PORT=8000
DATABASE_PATH=data/engine.db

# Proveedor GenAI: "demo" (default, sin credenciales) | "openai" (P1, requiere key).
GENAI_PROVIDER=demo

# Adaptador OpenAI-compatible (P1, opcional): dejá OPENAI_API_KEY vacío para
# usar DemoProvider. Nunca commitees tu key real.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# Fixture de fallo para la demo (segundo caso oficial): DEMO_FORCE_INVALID=1
# fuerza una salida JSON inválida para recorrer repair -> GENERATION_FAILED.
DEMO_FORCE_INVALID=false

# Guardar la salida cruda del provider en la traza (desactivado por defecto).
TRACE_STORE_RAW_OUTPUT=false

# Proveedor visual: "svg" (default) | "image" (P1, opcional).
VISUAL_PROVIDER=svg

# API de imágenes (P1, opcional): IMAGE_API_KEY vacía -> SVG determinístico.
IMAGE_API_URL=
IMAGE_API_KEY=

# Allowlist CORS separada por comas.
CORS_ORIGINS=http://localhost:5173
